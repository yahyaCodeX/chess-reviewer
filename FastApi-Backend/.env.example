# ============================================================
# Chess Reviewer — FastAPI Gateway  |  Environment Variables
# ============================================================
# 1. Copy this file:    cp .env.example .env
# 2. Fill in real values (the .env file is in .gitignore — never commit it!)
# 3. Run:               uvicorn main:app --reload --port 8080

# ============================================================
# POSTGRESQL  (Aiven)
# ============================================================
# Where to get it:
#   Aiven Console → Your PostgreSQL Service → Overview tab
#   → "Connection information" → copy the "Service URI"
#   It already includes host, port, user, password, and dbname.
#   Append  ?sslmode=require  at the end.
#
# Format:
#   postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# Example (replace with your real Aiven URI):
DATABASE_URL=postgresql+psycopg2://avnadmin:AVNS_xxxxxxxxxxxx@pg-chess-abc123.aivencloud.com:12345/defaultdb?sslmode=require

# ── Local Docker override ────────────────────────────────────
# Uncomment the line below (and comment out the Aiven line above)
# when running against the local docker-compose.yaml postgres service:
# DATABASE_URL=postgresql+psycopg2://chess_user:password123@localhost:5432/chess_data

# ============================================================
# KAFKA  (Aiven — mutual TLS / SSL)
# ============================================================
# Where to get these values:
#   Aiven Console → Your Kafka Service → Overview tab
#   → "Connection information"
#     • "Service URI"  →  copy host:port  (e.g. chess-kafka-xxx.aivencloud.com:23570)
#     • Download the three CA/cert/key files from the same panel
#       (or from the "Download CA cert" button).
#       Save them into  FastApi-Backend/certs/  as:
#           ca.pem  |  service.cert  |  service.key
#
# KAFKA_URL — host:port from the Aiven "Service URI" field
KAFKA_URL=chess-kafka-siddiquiyahya796-e171.b.aivencloud.com:23570

# KAFKA_SECURITY_PROTOCOL — must be "SSL" for Aiven
# Change to "PLAINTEXT" when using the local Docker Compose broker (no certs)
KAFKA_SECURITY_PROTOCOL=SSL

# ── SSL certificate paths ────────────────────────────────────
# These default to the certs/ folder next to main.py, so you only
# need to set these if you store certs in a non-standard location.
# (Leave them commented out if you copied the certs into FastApi-Backend/certs/)
#
# KAFKA_CA_CERT=certs/ca.pem
# KAFKA_CLIENT_CERT=certs/service.cert
# KAFKA_CLIENT_KEY=certs/service.key

# ============================================================
# SECURITY / CORS
# ============================================================
# Comma-separated origins allowed to call the API ("*" = any)
# CORS_ORIGINS=https://your-domain.example
# Enables DELETE /api/analysis/clear when sent as the X-Admin-Token header
# ADMIN_TOKEN=change-me

# ============================================================
# AI WORKER (read by ai-worker when sharing this file in Docker)
# ============================================================
# ENGINE_DEPTH=16          # lower = faster on small VMs (18 = original)
# ENGINE_THREADS=1
# MAX_PARALLEL_GAMES=2

# ── Local Docker override ────────────────────────────────────
# To use the local Docker Compose Kafka (no certs needed):
#   KAFKA_URL=localhost:9092
#   KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ============================================================
# PUBLIC DEPLOYMENT GUARDS
# ============================================================
# RATE_LIMIT_GAMES=5           # new games per visitor per window (duplicates are free)
# RATE_LIMIT_WINDOW_MIN=10
# MAX_PLIES=300                # longest game accepted (half-moves)
# STALL_SECONDS=240            # watchdog: retry a game after this much silence
# MAX_ATTEMPTS=3               # ...and give up after this many tries
# RATE_LIMIT_SALT=change-me    # salt for hashing visitor IPs (raw IPs are never stored)
