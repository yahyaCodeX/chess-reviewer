# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# The API's public address: your Azure VM's DNS name (Public IP → Configuration → DNS name label)
API_DOMAIN=chess-api.eastus.cloudapp.azure.com

# Your Vercel website address (allowed to call the API), comma-separate several
CORS_ORIGINS=https://chess-reviewer.vercel.app
# Optional: also allow Vercel preview deployments
CORS_ORIGIN_REGEX=https://chess-reviewer(-[a-z0-9-]+)?\.vercel\.app
# Optional: opening the API address in a browser redirects here
FRONTEND_URL=https://chess-reviewer.vercel.app

# Secrets — generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
RATE_LIMIT_SALT=
ADMIN_TOKEN=

# Engine / capacity (B2s: 2 vCPU)
ENGINE_DEPTH=16
MAX_PARALLEL_GAMES=2
RATE_LIMIT_GAMES=5
